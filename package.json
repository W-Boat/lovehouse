  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0"
  }
}