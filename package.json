{
  "name": "birthday-cottage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "python -X utf8 tools/prepare_assets.py && tsc --noEmit && vite build",
